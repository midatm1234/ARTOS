{
  "$defs": {
    "AuditFinding": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "finding_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Finding Id",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "description",
        "status"
      ],
      "title": "AuditFinding",
      "type": "object"
    },
    "AuditGate": {
      "enum": [
        "not_ready",
        "repair_required",
        "pass_with_disclosures",
        "pass"
      ],
      "title": "AuditGate",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "open",
        "repaired",
        "accepted",
        "not_reproducible"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Independence": {
      "additionalProperties": true,
      "properties": {
        "headline_results_independently_recomputed": {
          "items": {
            "type": "string"
          },
          "title": "Headline Results Independently Recomputed",
          "type": "array"
        },
        "primary_interpretation_withheld_on_first_pass": {
          "default": false,
          "title": "Primary Interpretation Withheld On First Pass",
          "type": "boolean"
        },
        "recomputation_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recomputation Method"
        },
        "separate_agent_session": {
          "default": false,
          "title": "Separate Agent Session",
          "type": "boolean"
        },
        "separate_work_dir": {
          "default": false,
          "title": "Separate Work Dir",
          "type": "boolean"
        }
      },
      "title": "Independence",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "artos://schemas/audit-findings.v2.schema.json",
  "additionalProperties": true,
  "properties": {
    "auditor_session": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auditor Session"
    },
    "checks": {
      "additionalProperties": true,
      "title": "Checks",
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AuditFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "gate": {
      "$ref": "#/$defs/AuditGate",
      "default": "not_ready"
    },
    "independence": {
      "$ref": "#/$defs/Independence"
    },
    "kind": {
      "const": "audit_findings",
      "default": "audit_findings",
      "title": "Kind",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "AuditFindings",
  "type": "object"
}
