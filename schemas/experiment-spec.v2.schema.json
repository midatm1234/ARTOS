{
  "$id": "artos://schemas/experiment-spec.v2.schema.json",
  "additionalProperties": false,
  "description": "One job ARTOS may submit. Its idempotency key is derived, not chosen.",
  "properties": {
    "code_refs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Code Refs",
      "type": "object"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "contract_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "estimated_cpu_hours": {
      "default": 0.0,
      "minimum": 0,
      "title": "Estimated Cpu Hours",
      "type": "number"
    },
    "estimated_gpu_hours": {
      "default": 0.0,
      "minimum": 0,
      "title": "Estimated Gpu Hours",
      "type": "number"
    },
    "executor": {
      "enum": [
        "local",
        "mcp",
        "mock"
      ],
      "title": "Executor",
      "type": "string"
    },
    "kind": {
      "const": "experiment_spec",
      "default": "experiment_spec",
      "title": "Kind",
      "type": "string"
    },
    "output_dir": {
      "title": "Output Dir",
      "type": "string"
    },
    "requires_gpu": {
      "default": false,
      "title": "Requires Gpu",
      "type": "boolean"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool"
    },
    "tool_args": {
      "additionalProperties": true,
      "title": "Tool Args",
      "type": "object"
    },
    "variant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Variant Id",
      "type": "string"
    },
    "working_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Working Dir"
    }
  },
  "required": [
    "run_id",
    "contract_sha256",
    "variant_id",
    "seed",
    "executor",
    "output_dir"
  ],
  "title": "ExperimentSpec",
  "type": "object"
}
