{
  "$defs": {
    "RankedHypothesis": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Card Id",
          "type": "string"
        },
        "criterion_means": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Criterion Means",
          "type": "object"
        },
        "hypothesis_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "judges": {
          "title": "Judges",
          "type": "integer"
        },
        "mean_score": {
          "title": "Mean Score",
          "type": "number"
        },
        "verdict": {
          "enum": [
            "accept",
            "defer",
            "reject"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "card_id",
        "mean_score",
        "criterion_means",
        "verdict",
        "judges"
      ],
      "title": "RankedHypothesis",
      "type": "object"
    }
  },
  "$id": "artos://schemas/ranking-result.v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "judge_ids": {
      "items": {
        "type": "string"
      },
      "title": "Judge Ids",
      "type": "array"
    },
    "kind": {
      "const": "ranking_result",
      "default": "ranking_result",
      "title": "Kind",
      "type": "string"
    },
    "method": {
      "default": "mean of criterion scores across blind judges; ties broken by card_id",
      "title": "Method",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Packet Sha256",
      "type": "string"
    },
    "ranked": {
      "items": {
        "$ref": "#/$defs/RankedHypothesis"
      },
      "title": "Ranked",
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "packet_sha256",
    "judge_ids",
    "ranked"
  ],
  "title": "RankingResult",
  "type": "object"
}
