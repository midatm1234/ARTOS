{
  "$defs": {
    "SourceType": {
      "enum": [
        "question",
        "email",
        "manuscript",
        "slides",
        "other"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "$id": "artos://schemas/research-question.v2.schema.json",
  "additionalProperties": false,
  "description": "The mother question. Stored verbatim and hashed; never edited.",
  "properties": {
    "kind": {
      "const": "research_question",
      "default": "research_question",
      "title": "Kind",
      "type": "string"
    },
    "mother_question": {
      "description": "The question as interpreted; recorded separately from hypotheses.",
      "minLength": 1,
      "title": "Mother Question",
      "type": "string"
    },
    "mother_question_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Mother Question Sha256",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "untrusted_input": {
      "default": true,
      "title": "Untrusted Input",
      "type": "boolean"
    },
    "verbatim_source": {
      "minLength": 1,
      "title": "Verbatim Source",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "source_type",
    "verbatim_source",
    "source_sha256",
    "mother_question",
    "mother_question_sha256",
    "received_at"
  ],
  "title": "ResearchQuestion",
  "type": "object"
}
