{
  "$defs": {
    "ClaimType": {
      "enum": [
        "published_finding",
        "proposed_idea",
        "local_measurement"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "conflicting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Evidence",
          "type": "array"
        },
        "expected_benefit": {
          "title": "Expected Benefit",
          "type": "string"
        },
        "falsification": {
          "description": "The result that would count against it.",
          "minLength": 10,
          "title": "Falsification",
          "type": "string"
        },
        "hypothesis_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "implementation_cost": {
          "title": "Implementation Cost",
          "type": "string"
        },
        "mechanism": {
          "minLength": 5,
          "title": "Mechanism",
          "type": "string"
        },
        "proposer_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposer Notes"
        },
        "proposer_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposer Rank"
        },
        "role": {
          "default": "candidate",
          "enum": [
            "candidate",
            "null",
            "control",
            "alternative"
          ],
          "title": "Role",
          "type": "string"
        },
        "statement": {
          "minLength": 10,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HypothesisStatus",
          "default": "proposed"
        },
        "supporting_evidence": {
          "description": "evidence_id references",
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "statement",
        "mechanism",
        "expected_benefit",
        "implementation_cost",
        "falsification"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "HypothesisStatus": {
      "enum": [
        "proposed",
        "accepted",
        "deferred",
        "rejected",
        "supported",
        "unsupported",
        "inconclusive"
      ],
      "title": "HypothesisStatus",
      "type": "string"
    },
    "LiteratureEvidence": {
      "additionalProperties": false,
      "description": "One source. ``verified`` means the primary page was fetched and matched.",
      "properties": {
        "citation": {
          "description": "arXiv ID, DOI, or repository path",
          "minLength": 3,
          "title": "Citation",
          "type": "string"
        },
        "claim": {
          "minLength": 5,
          "title": "Claim",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "first_author": {
          "title": "First Author",
          "type": "string"
        },
        "relation": {
          "enum": [
            "supports",
            "conflicts",
            "context"
          ],
          "title": "Relation",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "verification_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Method"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "citation",
        "title",
        "first_author",
        "year",
        "verified",
        "claim",
        "claim_type",
        "relation"
      ],
      "title": "LiteratureEvidence",
      "type": "object"
    }
  },
  "$id": "artos://schemas/hypothesis-set.v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/LiteratureEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "hypotheses": {
      "description": "Competing hypotheses; at least two.",
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "minItems": 2,
      "title": "Hypotheses",
      "type": "array"
    },
    "kind": {
      "const": "hypothesis_set",
      "default": "hypothesis_set",
      "title": "Kind",
      "type": "string"
    },
    "mother_question_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Mother Question Sha256",
      "type": "string"
    },
    "proposer": {
      "title": "Proposer",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "mother_question_sha256",
    "proposer",
    "hypotheses"
  ],
  "title": "HypothesisSet",
  "type": "object"
}
