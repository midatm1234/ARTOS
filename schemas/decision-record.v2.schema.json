{
  "$id": "artos://schemas/decision-record.v2.schema.json",
  "additionalProperties": false,
  "description": "Why an agent or the controller chose something, and on what evidence.",
  "properties": {
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Decision Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "kind": {
      "const": "decision_record",
      "default": "decision_record",
      "title": "Kind",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "decision_id",
    "actor",
    "decision",
    "rationale",
    "decided_at"
  ],
  "title": "DecisionRecord",
  "type": "object"
}
