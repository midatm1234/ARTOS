{
  "$defs": {
    "Route": {
      "enum": [
        "direct",
        "hybrid",
        "hypothesis"
      ],
      "title": "Route",
      "type": "string"
    }
  },
  "$id": "artos://schemas/route-decision.v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decided_by": {
      "title": "Decided By",
      "type": "string"
    },
    "kind": {
      "const": "route_decision",
      "default": "route_decision",
      "title": "Kind",
      "type": "string"
    },
    "rationale": {
      "minLength": 10,
      "title": "Rationale",
      "type": "string"
    },
    "route": {
      "$ref": "#/$defs/Route"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "route",
    "rationale",
    "decided_at",
    "decided_by"
  ],
  "title": "RouteDecision",
  "type": "object"
}
