{
  "$defs": {
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seed"
        },
        "split": {
          "default": "test",
          "enum": [
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        },
        "variant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "seed",
        "variable",
        "metric",
        "value"
      ],
      "title": "MetricValue",
      "type": "object"
    }
  },
  "$id": "artos://schemas/evaluation-result.v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "computed_at": {
      "format": "date-time",
      "title": "Computed At",
      "type": "string"
    },
    "computed_by": {
      "description": "Deterministic code path that produced these numbers",
      "title": "Computed By",
      "type": "string"
    },
    "contract_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "cost": {
      "additionalProperties": true,
      "title": "Cost",
      "type": "object"
    },
    "decisions": {
      "additionalProperties": true,
      "title": "Decisions",
      "type": "object"
    },
    "kind": {
      "const": "evaluation_result",
      "default": "evaluation_result",
      "title": "Kind",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:\\-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/MetricValue"
      },
      "title": "Values",
      "type": "array"
    },
    "verdicts": {
      "additionalProperties": {
        "enum": [
          "supported",
          "unsupported",
          "inconclusive"
        ],
        "type": "string"
      },
      "title": "Verdicts",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "contract_sha256",
    "computed_by",
    "computed_at",
    "values"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
